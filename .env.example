# ---------------------------------------------------------------------------
# Copiar a .env.local y rellenar. .env.local NUNCA se commitea.
# Los valores de desarrollo compartidos se piden al owner técnico.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Salta RLS: jamás debe aparecer en código de cliente
# ni en una variable con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (usada en enlaces de correo y en el manifest PWA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envío de correo para avisos de vencimiento (Etapa 1: Resend)
RESEND_API_KEY=
EMAIL_FROM="Plataforma <no-reply@ejemplo.com>"

# Secreto compartido que valida las llamadas del job de pg_cron
# a la ruta interna de generación de alertas.
CRON_SECRET=
