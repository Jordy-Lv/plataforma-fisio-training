# ---------------------------------------------------------------------------
# Copiar a .env.local y rellenar. .env.local NUNCA se commitea.
# Los valores de desarrollo compartidos se piden al owner técnico.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Las mismas coordenadas para los scripts de semilla y de verificación, que
# corren fuera de Next y no ven las variables NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Solo servidor. Salta RLS: jamás debe aparecer en código de cliente
# ni en una variable con prefijo NEXT_PUBLIC_. Se usa únicamente en el job de
# vencimientos y en los scripts de semilla.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (usada en enlaces de correo y en el manifest PWA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envío de correo para los avisos de vencimiento. `lib/progress/mailer.ts`
# habla SMTP directamente, así que vale cualquier proveedor; en la nube se usa
# Resend con smtps://resend:<API_KEY>@smtp.resend.com:465.
# En local, el Mailpit de Supabase: smtp://127.0.0.1:54325
SMTP_URL=
MAIL_FROM="Plataforma <no-reply@ejemplo.com>"

# Secreto compartido que valida las llamadas del job de pg_cron
# a la ruta interna de generación de alertas.
CRON_SECRET=
