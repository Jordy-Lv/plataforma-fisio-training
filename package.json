{
  "name": "plataforma-fisio-training",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:env": "node scripts/setup-local-env.mjs",
    "db:reset": "supabase db reset --local",
    "db:clean": "node scripts/check-db-clean.mjs",
    "test:auth": "node --test scripts/verify-auth-local.test.mjs",
    "test:auth:screens": "node --test scripts/verify-auth-screens.test.mjs",
    "test:rls": "node --test scripts/verify-rls.test.mjs",
    "test:actor-active": "node --test scripts/verify-actor-active.test.mjs",
    "test:storage": "node --test scripts/verify-catalog-storage.test.mjs",
    "test:catalog": "node --test scripts/verify-catalog-list.test.mjs",
    "test:catalog:custom": "node --test scripts/verify-catalog-custom.test.mjs",
    "test:templates": "node --test scripts/verify-catalog-templates.test.mjs",
    "test:templates:seed": "node --test scripts/verify-templates-seed.test.mjs",
    "test:rules:seed": "node --test scripts/verify-rules-seed.test.mjs",
    "test:rules:panel": "node --test scripts/verify-rules-panel.test.mjs",
    "test:rules": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/helpers/alias-hook.mjs --test scripts/verify-rules-engine.test.mjs",
    "seed:exercises": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-exercises.ts",
    "seed:templates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-templates.ts",
    "seed:rules": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-rules.ts",
    "seed:progress-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-progress-demo.ts",
    "seed:calendar-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-calendar-demo.ts",
    "db:types": "supabase gen types typescript --local --schema public > lib/db/types.ts",
    "test:people": "node --test scripts/verify-people-onboarding.test.mjs",
    "test:screenings": "node --test scripts/verify-progress-screenings.test.mjs",
    "test:attendance": "node --test scripts/verify-progress-attendance.test.mjs",
    "test:overview": "node --test scripts/verify-progress-overview.test.mjs",
    "test:routines": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/helpers/alias-hook.mjs --test scripts/verify-routine-assignment.test.mjs",
    "test:routines:snapshot": "node --test scripts/verify-routine-snapshot.test.mjs",
    "test:routines:items": "node --test scripts/verify-routine-items.test.mjs",
    "test:evolution": "node --test scripts/verify-progress-evolution.test.mjs",
    "test:plans": "node --test scripts/verify-progress-plans.test.mjs",
    "test:memberships": "node --test scripts/verify-progress-memberships.test.mjs",
    "test:memberships:cron": "node --test scripts/verify-progress-memberships-cron.test.mjs",
    "test:attendance:cron": "node --test scripts/verify-progress-attendance-cron.test.mjs",
    "test:routines:sessions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/helpers/alias-hook.mjs --test scripts/verify-routine-sessions.test.mjs",
    "test:auth:resilience": "node --test scripts/verify-onboarding-resilience.test.mjs",
    "test:design": "node --test scripts/verify-design-system.test.mjs",
    "test:calendar:dates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/helpers/alias-hook.mjs --test scripts/verify-calendar-dates.test.mjs",
    "test:calendar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/helpers/alias-hook.mjs --test scripts/verify-calendar.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "^30.0.1",
    "supabase": "2.116.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
